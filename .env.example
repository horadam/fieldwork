# Model execution is independent of storage. Default: installed local Ollama.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
# Explicit opt-in for unauthenticated inference. Development + loopback + same origin only.
# Never enables anonymous inference in production/hosted deployments.
LOCAL_WORKSPACE_ENABLED=true
# Optional cloud provider. Used only when AI_PROVIDER=openai; billed by OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional authenticated persistence; leave blank to use browser storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to "closed" on a public demo to hide "Create account". Also turn off
# "Allow new users to sign up" in Supabase; that is what enforces it.
NEXT_PUBLIC_SIGNUPS=
