{
  "name": "job-search-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:live": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "eval:resume": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-resume.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@openai/agents": "0.20.0",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7",
    "openai": "7.33.0",
    "pdfjs-dist": "file:vendor/pdfjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "prettier": "3.7.4"
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module"
}
